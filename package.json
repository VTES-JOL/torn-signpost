{
  "name": "torn-signpost",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "format": "biome check --write .",
    "dev:web": "pnpm --filter @torn-signpost/web dev",
    "synth": "pnpm build && pnpm --filter @torn-signpost/infra synth",
    "deploy": "pnpm build && pnpm --filter @torn-signpost/infra deploy",
    "sandbox": "pnpm --filter @torn-signpost/sandbox start",
    "dev": "pnpm db:up && turbo run dev --filter=@torn-signpost/backend --filter=@torn-signpost/web",
    "db:up": "docker compose -f local-dev/docker-compose.yml up -d && pnpm --filter @torn-signpost/backend db:init",
    "db:down": "docker compose -f local-dev/docker-compose.yml down",
    "content:ingest": "pnpm --filter @torn-signpost/content-ingest start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  }
}
